# پورت اجرای سرور (باید در فایروال ویندوز برای شبکه محلی باز باشد)
PORT=4500

# کلید رمزنگاری توکن ورود - قبل از استفاده واقعی حتما تغییر بدهید
JWT_SECRET=change-this-secret-key-before-production

# مسیر فایل دیتابیس (پیشنهاد: یک درایو/پوشه‌ی به‌اشتراک‌گذاشته‌شده در شبکه یا دیسک همین سرور)
DB_PATH=./data/anbar.db
