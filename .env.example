ENVIRONMENT=development
LOG_LEVEL=INFO
POSTGRES_DB=exam_builder
POSTGRES_USER=exam
POSTGRES_PASSWORD=exam
DATABASE_URL=postgresql+psycopg://exam:exam@postgres:5432/exam_builder
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=exam-builder
S3_SECRET_KEY=change-this-secret
S3_BUCKET=exam-files
S3_REGION=us-east-1
MAX_UPLOAD_MB=100
AUTH_SECRET_KEY=change-this-auth-secret
AUTH_ALGORITHM=HS256
AUTH_TOKEN_TTL_MINUTES=480
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
